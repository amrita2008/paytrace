# PayTrace Environment Variables
# Copy this file to .env and fill in values as needed.
# Never commit .env to version control.

# Application
PAYTRACE_DEBUG=false
PAYTRACE_HOST=127.0.0.1
PAYTRACE_PORT=8000

# Data paths (relative to project root)
PAYTRACE_DATA_DIR=data
PAYTRACE_EVALUATION_DIR=evaluation
